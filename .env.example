# Copy to .env and fill in, then run:  set -a; source .env; set +a; npm start
# (or just export the vars in your shell)

# --- Pick ONE free provider ---

# Groq — free tier, fastest inference (recommended). Get a key at https://console.groq.com
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=gsk_your_key_here

# Ollama — fully local, free, offline (run `ollama pull llama3.1` first)
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=

# OpenRouter free models — https://openrouter.ai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_API_KEY=sk-or-your_key_here

# Google Gemini — https://aistudio.google.com/apikey
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3-flash-preview
# AI_API_KEY=your_key_here

# --- Server ---
PORT=3000

# REQUIRED if you host this anywhere that isn't localhost.
# Anyone who reaches the page gets a shell on the machine — protect it.
# Then open: http://your-host:3000/?token=YOUR_TOKEN
AUTH_TOKEN=
